# Baken — environment. Copy to .env and fill in. (.env is gitignored.)

# Public hostname Caddy serves and requests a TLS certificate for.
# Point this DNS name at your server first; ports 80 and 443 must be reachable.
BAKEN_HOST=baken.example.com

# Optional fallback device id for the Overland bridge. Leave empty and set the
# "Device ID" inside the Overland app instead (to the Traccar device identifier).
BAKEN_DEFAULT_DEVICE_ID=

# How long Traccar keeps positions, in hours. Older positions are deleted every
# quarter of an hour; each device's newest position always stays, so nobody
# drops off the map. Leave empty (or 0) to keep everything forever.
# Needs a pruner account in Traccar — see docs/ADMIN.md, "Retention".
BAKEN_RETENTION_HOURS=24
BAKEN_PRUNER_EMAIL=pruner@baken.local
BAKEN_PRUNER_PASSWORD=
# Optional: never delete anything at or before this moment (ISO 8601, UTC),
# e.g. to keep the history you had before turning retention on.
BAKEN_PRUNE_FLOOR=

# Contact address sent (in the User-Agent) with address lookups to
# OpenStreetMap's public Nominatim, as its usage policy asks. Used only there.
BAKEN_CONTACT=you@example.com
